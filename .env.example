# Supabase Public API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Secret Key (DO NOT share or publish)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin Email
NEXT_PUBLIC_ADMIN_EMAIL=admin@loyalty.local

# TomTom Search API Key (Server-side) - Get your free key at https://developer.tomtom.com/
TOMTOM_API_KEY=your-tomtom-api-key-here
